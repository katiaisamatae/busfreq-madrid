# ============================================================
# Plantilla de variables de entorno.
# Copia este archivo a ".env" y rellena tus claves reales.
# El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# ============================================================

# --- API EMT Madrid (https://opendata.emtmadrid.es) ---
EMT_EMAIL=
EMT_PASSWORD=
EMT_CLIENT_ID=
EMT_PASSKEY=

# --- AEMET OpenData (https://opendata.aemet.es) ---
AEMET_API_KEY=

# --- Rutas (opcional, por defecto usan ./data) ---
DATA_RAW_DIR=datos/raw
DATA_PROCESSED_DIR=datos/processed

# --- Ticketmaster Discovery (https://developer.ticketmaster.com, opcional) ---
# Gratis, 5.000 llamadas/día. Sign up -> My Apps -> pega aquí la "Consumer Key".
# Sirve para conciertos y grandes eventos; los partidos de LaLiga ya se detectan
# sin clave (openfootball). Verifícala con: python scripts/test_ticketmaster.py
TICKETMASTER_API_KEY=
