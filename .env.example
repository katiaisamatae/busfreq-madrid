# ============================================================
# Plantilla de variables de entorno.
# Copia este archivo a ".env" y rellena tus claves reales.
# El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# ============================================================

# --- API EMT Madrid (https://opendata.emtmadrid.es) ---
EMT_EMAIL=
EMT_PASSWORD=
EMT_CLIENT_ID=
EMT_PASSKEY=

# --- AEMET OpenData (https://opendata.aemet.es) ---
AEMET_API_KEY=

# --- Rutas (opcional, por defecto usan ./data) ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
